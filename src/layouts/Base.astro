---
// Every page: head, the header with the main links, the page, then the contact footer.
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  theme?: string;
}

const { title, description, path, theme } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const home = path === '/';
const jsonLd = home
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: person.name,
      jobTitle: 'Full-stack engineer',
      url: site + '/',
      email: `mailto:${person.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Gurugram', addressCountry: 'IN' },
      sameAs: [person.github, person.linkedin, person.npm],
      worksFor: [
        { '@type': 'Organization', name: 'myVetbuddy', url: 'https://myvetbuddy.com' },
        { '@type': 'Organization', name: 'Astrodya', url: 'https://www.astrodya.com' },
      ],
    }
  : null;
---
<!doctype html>
<html lang="en" class={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + path} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/anek-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={home ? 'profile' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site + path} />
    <meta property="og:image" content={site + '/og.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="wrap top">
      <a class="brand" href="/"><span class="dot"></span>Aditya Singh</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/timeline/">Timeline</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap" id="contact">
      <section class="contact" aria-labelledby="contact-title">
        <p class="kicker">Contact</p>
        <h2 class="h2" id="contact-title">Have something to build?</h2>
        <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
        <div class="elsewhere">
          <a class="textlink" href={person.github}>GitHub</a>
          <a class="textlink" href={person.linkedin}>LinkedIn</a>
          <a class="textlink" href={person.npm}>npm</a>
        </div>
      </section>
      <p class="wordmark" lang="hi" aria-hidden="true">आदित्य सिंह</p>
      <div class="foot-line">
        <span>Aditya Singh · Gurugram, India · updated {person.updated}</span>
        <span><a href="/colophon/">How this site is built</a> · no JavaScript, no tracking</span>
      </div>
    </footer>
  </body>
</html>
