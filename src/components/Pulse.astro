---
// The pulse: commits per day across every repo on my machine since 1 July, one bar a day,
// with a coloured mark on each day something shipped and a few moments labelled.
// Built from git at build time and frozen into plain SVG.
import commits from '../data/commits.json';
import { shipped } from '../data/site';

const counts = commits as Record<string, number>;
const start = new Date('2026-07-01T00:00:00Z');
const end = new Date(`${shipped[0].iso}T00:00:00Z`);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const days: { iso: string; n: number; date: Date }[] = [];
for (let d = new Date(start); d <= end; d.setUTCDate(d.getUTCDate() + 1)) days.push({ iso: iso(d), n: counts[iso(d)] ?? 0, date: new Date(d) });

const W = 1200, H = 292, base = 246, top = 72;
const step = W / days.length;
const bw = Math.max(3, step * 0.62);
const max = Math.max(...days.map((d) => d.n));
const hOf = (n: number) => (n === 0 ? 0 : Math.max(3, Math.sqrt(n / max) * (base - top - 24)));
const fmt = (s: string) => new Date(`${s}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });

const byDay = new Map<string, typeof shipped>();
for (const s of shipped) byDay.set(s.iso, [...(byDay.get(s.iso) ?? []), s]);

const bars = days.map((d, i) => ({ x: i * step + (step - bw) / 2, h: hOf(d.n), d, rel: byDay.get(d.iso) ?? [] }));
const months = days
  .map((d, i) => ({ i, d }))
  .filter(({ d }) => d.date.getUTCDate() === 1)
  .map(({ i, d }) => ({ x: i * step, label: d.date.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' }) }));

// A few moments worth naming on the chart itself.
const notes = [
  { iso: '2026-09-10', text: 'JyotiKul starts', row: 24 },
  { iso: '2026-10-07', text: 'jyotikul.com live · VetBuddy redesign', row: 48 },
  { iso: '2026-10-19', text: 'duet 0.1.1 · iOS review', row: 24 },
].map((n) => {
  const i = days.findIndex((d) => d.iso === n.iso);
  return { ...n, x: i * step + step / 2, y: base - bars[i].h - 14 - bars[i].rel.length * 9 };
});

const inRange = days;
const total = inRange.reduce((a, d) => a + d.n, 0);
const active = inRange.filter((d) => d.n > 0).length;
let streak = 0, best = 0;
for (const d of inRange) { streak = d.n > 0 ? streak + 1 : 0; best = Math.max(best, streak); }
---
<div class="pulse">
  <div class="pulse-stats">
    <div><b>{total.toLocaleString('en-IN')}</b><span>commits since 1 July</span></div>
    <div><b>{active}</b><span>days with at least one</span></div>
    <div><b>{best}</b><span>days in a row, the longest run</span></div>
    <div><b>34</b><span>repos, for three companies and myself</span></div>
  </div>
  <div class="pulse-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Commits per day from 1 July to ${fmt(shipped[0].iso)}: ${total} in total, on ${active} days, with ${shipped.length} releases marked.`}>
      <g class="pulse-grid" aria-hidden="true">
        {months.map((m) => (
          <>
            <line x1={m.x} x2={m.x} y1={top - 10} y2={base}></line>
            <text x={m.x + 6} y={H - 14}>{m.label}</text>
          </>
        ))}
        <line class="pulse-base" x1="0" x2={W} y1={base} y2={base}></line>
      </g>
      <g class="pulse-bars">
        {bars.map((b) => (
          <rect class:list={{ busy: b.rel.length > 0 }} x={b.x.toFixed(1)} y={(base - b.h).toFixed(1)} width={bw.toFixed(1)} height={b.h.toFixed(1)} rx="1.5">
            <title>{`${fmt(b.d.iso)}: ${b.d.n} commit${b.d.n === 1 ? '' : 's'}${b.rel.length ? ' · ' + b.rel.map((r) => r.text).join(' ') : ''}`}</title>
          </rect>
        ))}
      </g>
      <g class="pulse-marks" aria-hidden="true">
        {bars.flatMap((b) => b.rel.map((r, k) => (
          <circle class={`c-${r.id}`} cx={(b.x + bw / 2).toFixed(1)} cy={(base - b.h - 7 - k * 9).toFixed(1)} r="3.6"></circle>
        )))}
      </g>
      <g class="pulse-notes" aria-hidden="true">
        {notes.map((n) => (
          <>
            <line x1={n.x} x2={n.x} y1={n.y + 4} y2={n.row + 6}></line>
            <text x={n.x - 6} y={n.row} text-anchor="end">{n.text}</text>
          </>
        ))}
      </g>
    </svg>
  </div>
  <p class="pulse-legend">
    <span>One bar a day, taller for more commits</span>
    <span><i class="c-jyotikul"></i><i class="c-vetbuddy"></i><i class="c-duet"></i> a coloured dot for each release, in its project’s colour</span>
    <span>Counted from git across 34 repos, my own and my employers’. Hover a bar for the day.</span>
  </p>
</div>
