---
// The home page body, shared by / and the theme lab pages.

import Shot from './Shot.astro';
import ProjectRow from './ProjectRow.astro';
import Pulse from './Pulse.astro';
import photo from '../assets/aditya.jpg';
import { person, projects, shipped, alsoBuilt, jobs, callouts, specialties, tags } from '../data/site';

const names = Object.fromEntries(projects.map((p) => [p.id, p.name]));
const vb = projects.find((p) => p.id === 'vetbuddy')!;
const vbFilm = vb.media.kind === 'screens' ? vb.media.videos[0] : undefined;

const jobKey: Record<string, string> = {
  myVetbuddy: 'vetbuddy',
  Astrodya: 'astrodya',
  'Yellow Owl Publisher': 'yellowowl',
  'MJP Rohilkhand University': 'uni',
};
const jobOrder = ['Astrodya', 'myVetbuddy', 'Yellow Owl Publisher', 'MJP Rohilkhand University'];
---
<section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <div class="who">
        <Shot src={photo} alt="Aditya Singh" widths={[48]} sizes="48px" eager />
        <p><b>{person.name}</b><span>Full-stack engineer · Gurugram, India</span></p>
      </div>
      <h1 id="hero-title">I build the app on your phone and the server behind it.</h1>
      <p class="lede">Co-founder and CTO at myVetbuddy. Full-stack developer at Astrodya.</p>
      <div class="actions">
        <a class="button" href={`mailto:${person.email}`}>Email me</a>
        <a class="textlink" href={person.github}>GitHub</a>
        <a class="textlink" href={person.linkedin}>LinkedIn</a>
      </div>
    </div>
    <nav class="index" aria-label="What I built">
      <p class="kicker">Seven things I built</p>
      <ol>
        {projects.map((p) => (
          <li class={`c-${p.id}`}>
            <a href={`#${p.id}`}><span class="dot"></span><b>{p.name}</b><span>{tags[p.id]}</span></a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section id="work" class="work wrap" aria-label="Work">
    {projects.map((p, i) => (
      <ProjectRow
        p={p}
        tag={tags[p.id]}
        specialties={specialties[p.id]}
        callouts={callouts[p.id]}
        video={p.id === 'vetbuddy' ? vbFilm : undefined}
        eager={i === 1}
      />
    ))}
  </section>

  <section class="section wrap" aria-labelledby="shipped-title">
    <p class="kicker">Timeline</p>
    <h2 class="h2" id="shipped-title">Every day since July.</h2>
    <Pulse />
    <ol class="latest">
      {shipped.slice(0, 5).map((s) => (
        <li class={`c-${s.id}`}><time datetime={s.iso}>{s.date}</time><span><b>{names[s.id]}</b> {s.text}</span></li>
      ))}
    </ol>
    <a class="go" href="/timeline/">Everything I shipped since July<span aria-hidden="true"> →</span></a>
  </section>

  <section class="section wrap" aria-labelledby="career-title">
    <p class="kicker">Work history</p>
    <h2 class="h2" id="career-title">Where I have worked.</h2>
    <div class="career">
      <div class="years" aria-hidden="true">{[2020, 2021, 2022, 2023, 2024, 2025, 2026].map((y) => <span>{y}</span>)}</div>
      {jobOrder.map((org) => {
        const j = jobs.find((x) => x.org === org)!;
        const key = jobKey[org];
        const now = j.when.endsWith('now');
        return (
          <div class={`job c-${key}`}>
            <div class:list={['lane', { now }]} aria-hidden="true"><span class={`span s-${key}`}><em>{j.when}</em></span></div>
            <div class="info"><b>{j.org}</b><span>{j.role}. {j.text}</span></div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="also-title">
    <p class="kicker">Also built</p>
    <ul class="also-list" id="also-title">
      {alsoBuilt.map((a) => <li><b>{a.name}</b> {a.text}</li>)}
      <li><b>Earlier</b> a railway booking app, a Frank and Oak storefront and more, <a href={`${person.github}?tab=repositories`}>on GitHub</a>.</li>
    </ul>
  </section>
