---
// A browser window drawn in CSS: an address bar with the real address, then the page.
import Shot from './Shot.astro';
import type { Shot as ShotData } from '../data/site';

interface Props {
  url: string;
  shot: ShotData;
  widths: number[];
  sizes: string;
  eager?: boolean;
}

const { url, shot, widths, sizes, eager } = Astro.props;
---
<div class="browser">
  <div class="bar" aria-hidden="true">
    <span class="url"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2.5" y="5.5" width="7" height="5" rx="1"></rect><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5"></path></svg>{url}</span>
  </div>
  <div class="view">
    <Shot src={shot.src} srcDark={shot.srcDark} alt={shot.alt} widths={widths} sizes={sizes} eager={eager} />
  </div>
</div>
