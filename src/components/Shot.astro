---
// A responsive picture: AVIF and WebP at several widths, an optional dark-mode
// variant, and a JPEG fallback. `widths` are display widths in CSS px; each is
// also built at 2x for sharp screens.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  srcDark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { src, srcDark, alt, widths, sizes, class: cls, eager = false } = Astro.props;
const formats = ['avif', 'webp'] as const;

async function srcset(img: ImageMetadata, format: (typeof formats)[number]) {
  const all = [...new Set(widths.flatMap((w) => [w, w * 2]).map((w) => Math.min(w, img.width)))].sort((a, b) => a - b);
  const built = await Promise.all(all.map((w) => getImage({ src: img, width: w, format, quality: format === 'avif' ? 60 : 78 })));
  return built.map((b, i) => `${b.src} ${all[i]}w`).join(', ');
}

const light = await Promise.all(formats.map((f) => srcset(src, f)));
const dark = srcDark ? await Promise.all(formats.map((f) => srcset(srcDark, f))) : null;
const fallback = await getImage({ src, width: Math.min(src.width, Math.max(...widths) * 2), format: 'jpg', quality: 80 });
---
<picture>
  {dark && formats.map((f, i) => <source type={`image/${f}`} media="(prefers-color-scheme: dark)" srcset={dark[i]} sizes={sizes} />)}
  {formats.map((f, i) => <source type={`image/${f}`} srcset={light[i]} sizes={sizes} />)}
  <img
    src={fallback.src}
    width={src.width}
    height={src.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class={cls}
  />
</picture>
