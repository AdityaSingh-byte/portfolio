---
// How a lead moves through the Astrodya platform. The CRM holds customer data,
// so the page shows this map instead of screenshots.
const columns = [
  { head: 'Leads come in', items: ['Facebook and Google ads', 'Click-to-WhatsApp', 'Website forms', 'Referral links'] },
  { head: 'One CRM', items: ['Leads, owners and tasks', 'A 29-task workflow engine', 'Roles enforced in the database'], core: true },
  { head: 'The team talks to them', items: ['WhatsApp, five providers', 'Browser dialer and call center', 'Video consultations'] },
  { head: 'After each conversation', items: ['Hinglish transcripts', 'AI client dossiers', 'PDF reports', 'Conversions sent back to Meta'] },
];
---
<figure class="system">
  <ol class="system__flow">
    {columns.map((c) => (
      <li class:list={['system__col', { 'system__col--core': c.core }]}>
        <p class="system__head">{c.head}</p>
        <ul>
          {c.items.map((it) => <li>{it}</li>)}
        </ul>
      </li>
    ))}
  </ol>
  <figcaption>How a lead moves through the platform. The CRM holds customer data, so here is a map of it instead of screenshots.</figcaption>
</figure>
